# Copy to .env and adjust. All values below are fake.

# API server
# TCP port the api listens on.
PORT=3000
# Interface the api binds to.
HOST=0.0.0.0
# Environment: development, test or production.
NODE_ENV=development
# Origin of the web app (used for CORS and cookies).
WEB_ORIGIN=http://localhost:5173

# Web dev server
# Where the Vite dev proxy forwards /api and /ws (defaults to http://localhost:3000).
API_URL=http://localhost:3000

# Database
# PostgreSQL connection string (local docker database started by `pnpm db:up`).
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban
# Database used by tests (its name must end in _test); CI sets DATABASE_URL to it instead.
TEST_DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban_test

# Secrets
# Secret used to sign sessions; at least 32 characters. Generate your own with `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
