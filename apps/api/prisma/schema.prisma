generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercased (the API normalises it).
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  memberships  Membership[]
  invites      Invite[]

  @@map("users")
}

enum WorkspaceRole {
  owner
  member
  viewer

  @@map("workspace_role")
}

model Workspace {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  projects    Project[]
  invites     Invite[]

  @@map("workspaces")
}

model Membership {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invite {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  /// SHA-256 (hex) of the link token; the token itself is never stored.
  tokenHash   String        @unique @map("token_hash")
  /// Only member or viewer (enforced by the API schema).
  role        WorkspaceRole
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  expiresAt   DateTime      @map("expires_at")
  maxUses     Int?          @map("max_uses")
  uses        Int           @default(0)
  revokedAt   DateTime?     @map("revoked_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("invites")
}

model Project {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  name           String
  key            String
  /// Next card number to hand out (KB-012 increments it atomically).
  nextCardNumber Int       @default(1) @map("next_card_number")
  createdAt      DateTime  @default(now()) @map("created_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board          Board?

  @@unique([workspaceId, key])
  @@map("projects")
}

/// One board per project (1:1). Created together with the project.
model Board {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   Column[]

  @@map("boards")
}

model Column {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  /// Fractional-index key (ADR 0001). The migration gives the column `COLLATE "C"` so the
  /// database sorts by code unit, matching `keyBetween`; Prisma cannot express that itself.
  position  String
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at")
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, position, id])
  @@map("columns")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the opaque cookie token; the token itself is never stored.
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Technical (non-domain) key/value table. It gives the `init` migration real content
/// (Prisma creates no migration for an empty schema) and is a place for app-level flags.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}
